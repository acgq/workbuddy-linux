# Generated by scripts/build-arch.py from a verified portable build.
pkgname=workbuddy
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc='Unofficial macOS-to-Linux port of Tencent WorkBuddy'
arch=('@ARCH@')
url='https://www.workbuddy.cn/app'
license=('LicenseRef-WorkBuddy' 'MIT')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'gcc-libs'
         'glib2' 'glibc' 'gtk3' 'libcups' 'libdrm' 'libx11' 'libxcb'
         'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon'
         'libxrandr' 'mesa' 'nspr' 'nss' 'pango' 'xdg-utils' 'zlib')
optdepends=('libappindicator-gtk3: system tray integration')
conflicts=('workbuddy-port')
replaces=('workbuddy-port')
# Keep the vendor runtime and bundled native modules byte-for-byte intact.
options=('!strip' '!debug' 'staticlibs' 'libtool' '!zipman' '!purge')
source=('@ARCHIVE@' 'WorkBuddy.desktop' 'workbuddy-launcher' 'LICENSE')
sha256sums=(@CHECKSUMS@)

package() {
  install -dm755 "$pkgdir/opt"
  cp -a "$srcdir/WorkBuddy" "$pkgdir/opt/WorkBuddy"
  chmod 4755 "$pkgdir/opt/WorkBuddy/chrome-sandbox"
  install -Dm755 "$srcdir/workbuddy-launcher" "$pkgdir/usr/bin/workbuddy"
  install -Dm644 "$srcdir/WorkBuddy.desktop" "$pkgdir/usr/share/applications/workbuddy.desktop"
  install -Dm644 "$srcdir/WorkBuddy/resources/app.asar.unpacked/resources/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/workbuddy.png"
  install -Dm644 "$srcdir/WorkBuddy/NOTICE-linux.txt" "$pkgdir/usr/share/licenses/workbuddy/NOTICE"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/workbuddy/packaging-MIT"
}
