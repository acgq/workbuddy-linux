# Maintainer: acgq <chen330021 at live dot com>
# Generated by scripts/aur.py from a verified GitHub Release archive.
pkgname=workbuddy-cn-bin
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc='Tencent WorkBuddy China edition (unofficial macOS-to-Linux port)'
arch=('x86_64')
url='https://github.com/acgq/workbuddy-linux'
license=('LicenseRef-WorkBuddy' 'MIT')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'gcc-libs'
         'glib2' 'glibc' 'gtk3' 'libcups' 'libdrm' 'libx11' 'libxcb'
         'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon'
         'libxrandr' 'mesa' 'nspr' 'nss' 'pango' 'xdg-utils' 'zlib')
optdepends=('libappindicator-gtk3: system tray integration')
provides=("workbuddy=${pkgver}" 'workbuddy-cn')
conflicts=('workbuddy' 'workbuddy-bin' 'workbuddy-agent' 'workbuddy-port' 'workbuddy-cn'
           'workbuddy-international' 'workbuddy-international-bin' 'workbuddy-intl-agent')
# Preserve the vendor runtime, native modules and bundled archives.
options=('!strip' '!debug' 'staticlibs' 'libtool' '!zipman' '!purge')
source=('@SOURCE_URL@' 'WorkBuddy.desktop' 'workbuddy-launcher' 'LICENSE')
sha256sums=(@CHECKSUMS@)

package() {
  install -dm755 "$pkgdir/opt"
  cp -a "$srcdir/WorkBuddy" "$pkgdir/opt/WorkBuddy"
  chmod 4755 "$pkgdir/opt/WorkBuddy/chrome-sandbox"
  install -Dm755 "$srcdir/workbuddy-launcher" "$pkgdir/usr/bin/workbuddy"
  install -Dm644 "$srcdir/WorkBuddy.desktop" "$pkgdir/usr/share/applications/workbuddy.desktop"
  install -Dm644 "$srcdir/WorkBuddy/resources/app.asar.unpacked/resources/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/workbuddy.png"
  install -Dm644 "$srcdir/WorkBuddy/NOTICE-linux.txt" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/packaging-MIT"
}
